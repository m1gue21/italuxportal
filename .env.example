# Supabase (catálogo inversionistas administrable)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Publishable / anon (frontend). Acepta el nombre nuevo o el histórico:
VITE_SUPABASE_KEY="sb_publishable_..."
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Solo para scripts de seed / admin server (NUNCA en el frontend)
# Settings → API → service_role (o Secret key sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
